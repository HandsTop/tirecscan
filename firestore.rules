rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function active() { return signedIn() && (admin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true)); }
    function assigned(containerId) { return admin() || get(/databases/$(database)/documents/containers/$(containerId)).data.assignedTo == request.auth.uid; }

    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if false;
    }
    match /containers/{containerId} {
      allow read: if active();
      allow create, update, delete: if false;
      match /items/{itemId} {
        allow read: if active() && assigned(containerId);
        allow create, update, delete: if false;
      }
    }
    match /auditLogs/{entryId} {
      allow read: if admin();
      allow create, update, delete: if false;
    }
    match /tires/{ean} {
      allow read: if active();
      allow create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
